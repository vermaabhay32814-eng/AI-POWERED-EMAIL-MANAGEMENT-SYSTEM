# Server Configuration
PORT=5001
NODE_ENV=development
FRONTEND_URL=http://localhost:5173

# MongoDB Connection
# Set to your MongoDB Atlas or local MongoDB URI.
# If left empty or unreachable, an intelligent in-memory store is automatically used.
MONGODB_URI=mongodb://localhost:27017/email_assistant

# JWT Authentication Secret
JWT_SECRET=super_secret_jwt_key_change_in_production_2026

# Google OAuth 2.0 Credentials (for Live Gmail Integration)
# Get from: https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here
GOOGLE_REDIRECT_URI=http://localhost:5001/api/gmail/callback

# Gemini AI Key (for AI Summarization, Smart Replies & Classification)
# Get from: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here
